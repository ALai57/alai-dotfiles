
""" Map leader to space ---------------------
let mapleader = " "

" T prefix = test
" TT = unit test
map tt <Action>(RunClass)

" TF = test file
map tf <Action>(Run)


" S prefix = search
map sp <Action>(SearchEverywhere)
map ss <Action>(Find)


map <A-`> <Action>(ActivateProjectToolWindow)

" Project level commands
map <leader>pf <Action>(GotoFile)

map <leader>wn <Action>(NextSplitter)
map <leader>wp <Action>(PrevSplitter)
map <leader>wo <Action>(MaximizeEditorInSplit)
map <leader>ws <Action>(SplitHorizontally)
map <leader>wv <Action>(SplitVertically)
map <leader>bd <Action>(CloseActiveTab)

map <leader>wt <Action>(ActivateTerminalToolWindow)
map <leader>wm <Action>(HideSideWindows)
map <leader>w` <Action>(SelectInProjectView)

" ` = Terminal
" :map ` <Action>(ActivateTerminalToolWindow)
" map <C-t> <Action>(ActivateTerminalToolWindow

" Git commands
" map <leader>gs <Action>(Git.MainMenu)
map <leader>gs <Action>(Git.Stage.Compare.Local.Staged)


" Map <leader>d to start debug
map <leader>d <Action>(Debug)